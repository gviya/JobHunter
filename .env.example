# ==================================================================
# .env.example — Plantilla de variables de entorno.
#
# USO: copia este archivo como `.env` y rellena los valores.
#      El archivo `.env` está en .gitignore: NUNCA se sube al repo.
#      docker-compose lo lee automáticamente (con --env-file .env).
# ==================================================================

# ── Base de datos ──────────────────────────────────────────────────
DB_SA_PASSWORD=Dev_Password123!
POSTGRES_PASSWORD=postgres

# ── JWT (mínimo 32 caracteres para HMAC-SHA256) ────────────────────
JWT_SECRET=clave_secreta_de_desarrollo_minimo_32_caracteres!

# ── RabbitMQ ───────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ── API Key para endpoints internos (filtro ApiKeyAuthFilter) ──────
API_KEY=dev-api-key-cambiame

# ── Azure (solo producción; en local se dejan vacíos) ──────────────
# En producción los secretos NO van en .env: van en Azure Key Vault
# y la API los carga al arrancar (ver appsettings.Production.json).
AZURE_KEY_VAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
