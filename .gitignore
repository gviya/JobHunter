# ------------------------------------------------------------------
# .gitignore para soluciones .NET
# Ignora artefactos de compilación, archivos de IDE y secretos locales.
# ------------------------------------------------------------------

# Artefactos de compilación
**/bin/
**/obj/
**/out/
*.user

# Bases de datos SQLite locales (jobhunter.db, hangfire.db)
data/
*.db
*.db-shm
*.db-wal

# Visual Studio / Rider / VS Code
.vs/
.idea/
*.suo
*.userosscache
*.sln.docstates

# Resultados de tests y cobertura
TestResults/
coverage*.xml
coverage*.json
coverage*.info
*.trx

# Secretos y configuración local (NUNCA subir credenciales al repositorio)
.env
appsettings.Local.json
*.pfx

# Logs generados por Serilog en local
logs/
*.log

# Informe HTML generado localmente (contiene datos personales de la búsqueda)
informe.html
informe*.html

# NuGet
*.nupkg
packages/

.claude/settings.local.json

# Documentación personal de aprendizaje (no forma parte del repo)
docs/
