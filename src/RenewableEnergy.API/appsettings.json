{
  // ================================================================
  // appsettings.json — Configuración BASE (todos los entornos).
  // Los valores específicos de cada entorno van en
  // appsettings.{Entorno}.json, que SOBRESCRIBE a este archivo.
  // ⚠️ AQUÍ NUNCA HAY SECRETOS: contraseñas y claves llegan por
  // variables de entorno (local/Docker) o Azure Key Vault (producción).
  // ================================================================

  "ConnectionStrings": {
    // La contraseña real se inyecta por entorno; este valor es solo
    // el formato de referencia.
    "DefaultConnection": "Server=localhost,1433;Database=RenewableEnergyDb;User Id=sa;TrustServerCertificate=True;",
    "PostgreSql": "Host=localhost;Port=5432;Database=RenewableEnergyDb;Username=postgres;"
  },

  // Serilog se configura desde aquí: cambiar niveles o añadir sinks
  // no requiere recompilar.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },

  // Worker del patrón Outbox.
  "Outbox": {
    "Enabled": true,
    "IntervalInSeconds": 10,
    "BatchSize": 20
  },

  // MassTransit/RabbitMQ. Deshabilitado por defecto: la API funciona
  // sin broker (se registra un publisher que solo loguea).
  "Messaging": {
    "Enabled": false
  },
  "MassTransit": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },

  // Caché distribuida: false = memoria local, true = Redis.
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379"
  },

  // JWT: el Secret NO está aquí (variable de entorno JWT_SECRET o Key Vault,
  // que lo aporta como clave de configuración "Jwt:Secret").
  "Jwt": {
    "Issuer": "RenewableEnergyAPI",
    "Audience": "RenewableEnergyClient",
    "ExpirationInMinutes": 60
  },

  // API Key de los endpoints /ops (cabecera X-Api-Key). Sin valor aquí:
  // llega por la variable de entorno API_KEY (sección plana "ApiKey").
  "ApiKey": "",

  "RateLimiting": {
    "Policy": "PerUser",
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 5
  },

  // Azure Key Vault: con URL configurada, Program.cs carga los secretos
  // al arrancar. Vacío = deshabilitado (local).
  "AzureKeyVault": {
    "Url": ""
  },

  "AllowedHosts": "*"
}
