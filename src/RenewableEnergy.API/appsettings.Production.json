{
  // ================================================================
  // Configuración de PRODUCCIÓN (Azure App Service / Kubernetes).
  //
  // AQUÍ NO HAY NI UN SOLO SECRETO. Todo lo sensible llega de:
  // - Azure Key Vault (Program.cs lo carga si AzureKeyVault:Url tiene
  //   valor): ConnectionStrings--DefaultConnection, Jwt--Secret, ApiKey...
  // - O variables de entorno inyectadas por el orquestador
  //   (ver k8s/deployment.yaml).
  // ================================================================

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
      // Para enviar logs a Application Insights, añade el sink con la
      // connection string del recurso (que vendría de Key Vault):
      // {
      //   "Name": "ApplicationInsights",
      //   "Args": {
      //     "connectionString": "#{APPLICATIONINSIGHTS_CONNECTION_STRING}#",
      //     "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
      //   }
      // }
    ]
  },

  // En producción el broker está siempre habilitado (RabbitMQ gestionado
  // o Azure Service Bus — ver DependencyInjection de Infrastructure).
  "Messaging": {
    "Enabled": true
  },

  "Redis": {
    "Enabled": true
  },

  // La URL real la inyecta el pipeline de despliegue.
  "AzureKeyVault": {
    "Url": ""
  }
}
