<!--
  ==================================================================
  RenewableEnergy.API — La capa de PRESENTACIÓN (HTTP).

  Responsabilidades: recibir peticiones, autenticar (JWT), construir
  Commands/Queries, enviarlos por MediatR y traducir el Result a HTTP.
  AQUÍ NO HAY LÓGICA DE NEGOCIO (los tests de arquitectura lo verifican).

  Es también la COMPOSITION ROOT: el único proyecto que referencia
  Application e Infrastructure a la vez para cablear la inyección de
  dependencias en Program.cs.
  ==================================================================
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\RenewableEnergy.Application\RenewableEnergy.Application.csproj" />
    <ProjectReference Include="..\RenewableEnergy.Infrastructure\RenewableEnergy.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup Label="OpenAPI y versionado">
    <!-- Swagger UI clásico (el que piden casi todas las ofertas).
         Nota: NO se referencia Microsoft.AspNetCore.OpenApi (el generador
         integrado de .NET) para no duplicar generadores: Swashbuckle ya
         produce el documento OpenAPI y la UI -->
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <!-- Versionado de API: /api/v1/..., /api/v2/... -->
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
  </ItemGroup>

  <ItemGroup Label="Seguridad">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup Label="Logging y observabilidad">
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Serilog.Sinks.ApplicationInsights" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>

  <ItemGroup Label="Azure">
    <!-- Cargar secretos desde Key Vault al arrancar (solo producción) -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <ItemGroup Label="EF Core (solo tooling de migraciones)">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
